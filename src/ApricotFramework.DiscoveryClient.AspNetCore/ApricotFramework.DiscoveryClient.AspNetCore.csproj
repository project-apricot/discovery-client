    <PackageTags>service-discovery;discovery;microservices;kubernetes;aspnetcore;dependencyinjection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.DiscoveryClient/ApricotFramework.DiscoveryClient.csproj" />
  </ItemGroup>

</Project>
